{
  "name": "@deepseek-ai/dsh-plugin-vm-sandbox",
  "version": "0.2.1",
  "description": "OrbStack VM sandbox v0.2.0: web UI tabs (snapshots/jobs/audit/network), cron tasks, auto snapshot policies, template library, hot resize, export/import, metrics history, multi-machine groups/fail-fast, network allowlist and service discovery.",
  "type": "module",
  "scripts": {
    "prepare": "node ./scripts/prepare.mjs",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "ui-test": "node scripts/ui-test.mjs"
  },
  "main": "dsh-plugin-vm-sandbox/lib/index.js",
  "exports": {
    ".": "./dsh-plugin-vm-sandbox/lib/index.js",
    "./client": "./dsh-plugin-vm-sandbox/lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh-plugin-vm-sandbox/lib",
    "dsh-plugin-vm-sandbox/cordis.patch.yml",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dsh-plugin-vm-sandbox/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "Apache-2.0"
}
