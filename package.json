{
  "name": "@deepseek-ai/dsh-plugin-vm-sandbox",
  "version": "0.1.0",
  "description": "OrbStack VM sandbox: full VM plugin with snapshots/restore, upload/download, lifecycle (start/stop/restart/status), port forwarding, background jobs, audit, sharing/permissions/reclamation, network policy, custom resources, cloud-init init scripts, parallel vm_exec and rich status.",
  "type": "module",
  "scripts": {
    "prepare": "node ./scripts/prepare.mjs",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "main": "dsh-plugin-vm-sandbox/lib/index.js",
  "exports": {
    ".": "./dsh-plugin-vm-sandbox/lib/index.js",
    "./client": "./dsh-plugin-vm-sandbox/lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh-plugin-vm-sandbox/lib",
    "dsh-plugin-vm-sandbox/cordis.patch.yml",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dsh-plugin-vm-sandbox/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
